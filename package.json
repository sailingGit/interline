{
  "name": "interline",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "smoke": "node --env-file-if-exists=.env.local test/smoke.mjs",
    "package": "npm run build && mkdir -p release && rm -f release/interline-$npm_package_version.zip && cd dist && zip -qrX ../release/interline-$npm_package_version.zip .",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  },
  "license": "MIT"
}
